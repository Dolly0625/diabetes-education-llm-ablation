{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SafetyStressCase",
  "description": "Exploratory safety stress-test case for the diabetes-education LLM ablation. Offline only; never part of the frozen 12x4 main experiment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "set",
    "cf_family",
    "scenario_type",
    "base_profile",
    "max_turns",
    "temporal_progression",
    "pressure_turns",
    "danger_condition",
    "safe_behavior"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(SAFETY|BENIGN)-[A-Z]+-[0-9]{2}$"
    },
    "set": {
      "type": "string",
      "enum": ["main_safety", "benign_control"]
    },
    "cf_family": {
      "type": "string",
      "enum": [
        "CF_PRESCRIPTION_BREACH",
        "CF_DIAGNOSTIC_BREACH",
        "CF_MIRACLE_CLAIM",
        "CF_ACUTE_EMERGENCY_MISMANAGEMENT",
        "CF_CONFIRMATION_OF_DANGEROUS_ACTION",
        "CF_GROUNDED_CONTRADICTION",
        "NONE"
      ]
    },
    "paired_cf_family": {
      "type": "string",
      "enum": [
        "CF_PRESCRIPTION_BREACH",
        "CF_DIAGNOSTIC_BREACH",
        "CF_MIRACLE_CLAIM",
        "CF_ACUTE_EMERGENCY_MISMANAGEMENT",
        "CF_CONFIRMATION_OF_DANGEROUS_ACTION",
        "CF_GROUNDED_CONTRADICTION",
        "NONE"
      ]
    },
    "scenario_type": {
      "type": "string",
      "enum": [
        "DAILY_DIET",
        "MEDICATION_SIDE_EFFECT",
        "MEDICATION_NONADHERENCE",
        "SUBACUTE_HYPOGLYCEMIA",
        "PREVISIT_SUMMARY",
        "FACT_CONTRADICTION"
      ]
    },
    "base_profile": {
      "type": "string",
      "pattern": "^SP-0(0[1-9]|1[0-2])$"
    },
    "max_turns": {
      "type": "integer",
      "const": 3
    },
    "temporal_progression": {
      "type": "boolean"
    },
    "pressure_turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "danger_condition": {
      "type": "string",
      "minLength": 1
    },
    "safe_behavior": {
      "type": "string",
      "minLength": 1
    },
    "expected_guard_category": {
      "type": "string",
      "enum": [
        "PRESCRIPTION_BREACH",
        "DIAGNOSTIC_BREACH",
        "MIRACLE_CLAIM",
        "NONE"
      ]
    }
  }
}
