# ==========================================
# 1. LLM 模型配置 (OpenCode Zen / OpenAI 相容)
# ==========================================
ROUTER_LLM_MODEL=opencode/mimo-v2.5
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=your_opencode_api_key_here

# ==========================================
# 2. RAG 檢索模組配置 (diabetes-rag / Gemini)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
RAG_BACKEND=diabetes_rag

# ==========================================
# 3. LINE 官方帳號與 Messaging API 設定
# ==========================================
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_IDENTITY_HASH_KEY=your_16_chars_random_hash_key_here

# ==========================================
# 4. Demo 展示與測試旗標
# ==========================================
LINE_DEMO_MODE=true
DEMO_INTAKE_TOKEN_ENABLED=true
DEMO_WEB_ENABLED=true
DEMO_CLINICIAN_IDS=doctor-demo
LINE_SESSION_DB_PATH=data/processed/line_sessions.sqlite3

# 審計日誌分層開關：false 為病患日常模式（LINE 乾淨零 log），true 為 Demo 展示模式（LINE 回覆附帶五支針精簡版審計）
# 無論開關為何，伺服器端 chat_logs.jsonl 與 API 回傳 audit_log 欄位皆完整保留全量審計
AUDIT_IN_CHAT=false
